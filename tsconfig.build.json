/*
 * Library packaging only.
 *
 * During development the app compiles libraries straight from source (see the
 * `paths` in tsconfig.json) so there is nothing to rebuild between edits. When
 * packaging a library for publication each dependency must instead resolve to
 * its BUILT package, otherwise ng-packagr tries to compile a sibling's sources
 * into the bundle. Hence the same names, pointed at dist/.
 *
 * Build in dependency order: `npm run build:libs`.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@backoffice/domain": ["dist/domain"],
      "@backoffice/ui-kit": ["dist/ui-kit"],
      "@backoffice/shell": ["dist/shell"],
      "@backoffice/capability-workspace": ["dist/capability-workspace"],
      "@backoffice/capability-worklist": ["dist/capability-worklist"],
      "@thg/capability-potential-customers": ["dist/capability-potential-customers"]
    }
  }
}
