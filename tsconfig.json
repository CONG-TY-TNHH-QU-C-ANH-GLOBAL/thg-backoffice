{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "baseUrl": ".",
    "paths": {
      "@backoffice/domain": [
        "projects/platform/domain/src/public-api.ts"
      ],
      "@backoffice/ui-kit": [
        "projects/platform/ui-kit/src/public-api.ts"
      ],
      "@backoffice/shell": [
        "projects/platform/shell/src/public-api.ts"
      ],
      "@backoffice/capability-workspace": [
        "projects/capabilities/workspace/src/public-api.ts"
      ],
      "@backoffice/capability-worklist": [
        "projects/capabilities/worklist/src/public-api.ts"
      ],
      "@thg/capability-potential-customers": [
        "projects/capabilities/potential-customers/src/public-api.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  }
}
