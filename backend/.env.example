# Backoffice Foundation — biến môi trường.
# Copy sang .env. Thiếu biến bắt buộc thì ứng dụng TỪ CHỐI khởi động,
# không chạy tiếp với giá trị mặc định đoán mò.

NODE_ENV=development
PORT=3000

# Một deployment = một database. Đây không phải SaaS multi-tenant.
DATABASE_URL=postgres://backoffice:backoffice@localhost:5432/backoffice

# error | warn | log | debug | verbose
LOG_LEVEL=log
